# -----------------------------------------------------------------------------
# Card Vault - environment template (dev base)
# This committed file is the base for every environment. .env.prod and
# .env.preprod are committed overrides layered on top. Real secrets live in
# gitignored local overrides:
#   .env.local          dev, secret overrides only, generated by `castor setup:env`
#   .env.prod.local     prod, secret overrides only, created on the host
#   .env.preprod.local  preprod, secret overrides only, created on the host
# Never commit real secrets in this file.
# -----------------------------------------------------------------------------

# ===== PROJECT =====
# Project
PROJECT_NAME=cardvault
PROJECT_ENV=dev
PROJECT_DOMAIN=card-vault.localhost
PROJECT_USER_ID=1000
PROJECT_GROUP_ID=1000
PROJECT_IMAGE_TAG=latest
DOCKER_REGISTRY=ghcr.io/franck-dev-hub

# Versions: written only here; Renovate reads the comment above each
# renovate: datasource=docker depName=php
PHP_VERSION=8.5
# renovate: datasource=docker depName=dunglas/frankenphp
FRANKENPHP_VERSION=1.12.7
# renovate: datasource=docker depName=composer/composer
COMPOSER_VERSION=2.10
# renovate: datasource=docker depName=mlocati/php-extension-installer
PHP_EXTENSION_INSTALLER_VERSION=2
# renovate: datasource=github-releases depName=jolicode/castor versioning=semver extractVersion=^v(?<version>.+)$
CASTOR_VERSION=1.8.1
# renovate: datasource=docker depName=node
NODEJS_VERSION=26
# renovate: datasource=npm depName=pnpm versioning=npm
PNPM_VERSION=12.8.1
# renovate: datasource=docker depName=mcr.microsoft.com/playwright versioning=semver extractVersion=^v(?<version>\d+\.\d+\.\d+)-noble$
PLAYWRIGHT_VERSION=1.63.0
# renovate: datasource=docker depName=python
PYTHON_VERSION=3.14
PYTHON_DIGEST=sha256:0741d101873c12ab927e6f8653feb8862b9bd58771177acb1b885b95141f91b4
# renovate: datasource=docker depName=ghcr.io/astral-sh/uv
UV_VERSION=0.12.21
UV_DIGEST=sha256:a7aed3216253ee804de3e2d8afa5073baa1a177335345d43845cd4165e43b711
# renovate: datasource=docker depName=postgres
POSTGRES_VERSION=18
# renovate: datasource=docker depName=redis
REDIS_VERSION=8
# renovate: datasource=docker depName=caddy
CADDY_VERSION=2.11

# ===== BACKEND =====
# PHP extensions
PHP_EXTENSIONS="intl opcache apcu pdo_pgsql redis sodium"
SESSION_LIFETIME=604800

# API / Symfony
APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
XDEBUG_MODE=debug

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Postgres admin
PGADMIN_EMAIL=admin@exemple.com
PGADMIN_PASSWORD=change-me

# Redis
REDIS_CACHE_MAXMEMORY=256mb
REDIS_SESSION_MAXMEMORY=64mb

# ===== FRONTEND =====

# ===== MACHINE LEARNING =====
# ML service
HF_TOKEN=change-me
