# FrankenPHP embedded Caddy - serves the Symfony/API Platform app on :8000
# The front proxy (Caddy) routes /api/* here and terminates TLS.
{
	admin 127.0.0.1:2019
}

:8000 {
	root * {$CADDY_ROOT_FOLDER}
	php_server

	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
}
