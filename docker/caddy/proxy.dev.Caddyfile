# Front proxy (Caddy) - development entry point (HTTP only, no TLS)
# Routes /api/* to the FrankenPHP API, /ml/* to the ML service, everything else to the Angular dev server.
:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /ml/* {
		reverse_proxy ml:5000
	}

	handle {
		reverse_proxy frontend:4200
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
}
