# Front proxy (Caddy) - production entry point
# Routes /api/* to the FrankenPHP API, everything else to the Angular frontend. /ml/* answers 404: ML is internal only.
{$CADDY_DOMAIN_NAME:localhost} {
	encode zstd gzip

	handle /api {
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /bundles/* {
		reverse_proxy api:8000
	}

	handle /ml/* {
		respond 404
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
