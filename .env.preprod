# -----------------------------------------------------------------------------
# Card Vault - preprod environment overrides
# Layered on top of .env (committed base placeholders). Only add variables
# that differ from .env. Secrets never go here: they live in the gitignored
# .env.preprod.local, created on the host.
# -----------------------------------------------------------------------------

# ===== PROJECT =====
# Project
PROJECT_ENV=preprod
PROJECT_DOMAIN=card-vault.preprod

# API / Symfony
APP_SECRET=change-me

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=postgres

# Postgres admin
PGADMIN_EMAIL=admin@exemple.com
PGADMIN_PASSWORD=change-me

# ML service
HF_TOKEN=change-me
