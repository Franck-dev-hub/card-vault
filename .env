# -----------------------------------------------------------------------------
# Card Vault - environment template (dev base)
# This committed file is the base for every environment. .env.prod and
# .env.preprod are committed overrides layered on top. Real secrets live in
# gitignored local overrides, generated by `make env`:
#   .env.local          dev, full copy
#   .env.prod.local     prod, secret overrides only
#   .env.preprod.local  preprod, secret overrides only
# Never commit real secrets in this file.
# -----------------------------------------------------------------------------

# Project
PROJECT_NAME=cardvault
PROJECT_ENV=dev
PROJECT_DOMAIN=card-vault.fr
PROJECT_USER_ID=1000
PROJECT_GROUP_ID=1000
PROJECT_IMAGE_TAG=latest
DOCKER_REGISTRY=ghcr.io/franck-dev-hub

# Versions
PHP_VERSION=8.4
FRANKENPHP_VERSION=1.12.6
COMPOSER_VERSION=2.9
NODEJS_VERSION=22
PYTHON_VERSION=3.12
POSTGRES_VERSION=16
REDIS_VERSION=7
CADDY_VERSION=2.10

# PHP extensions
PHP_EXTENSIONS="intl opcache apcu pdo_pgsql redis sodium"
SESSION_LIFETIME=604800

# API / Symfony
APP_ENV=dev
APP_SECRET=change-me
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
XDEBUG_MODE=debug

# Database
POSTGRES_DB=cardvault
POSTGRES_USER=cardvault
POSTGRES_PASSWORD=change-me

# Tools
PGADMIN_PASSWORD=change-me

# ML service
HF_TOKEN=

# CI / E2E
PLAYWRIGHT_VERSION=1.49.0
