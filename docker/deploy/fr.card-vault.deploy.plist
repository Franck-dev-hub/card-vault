<?xml version="1.0" encoding="UTF-8"?>
<!-- Template: launchd expands neither ~ nor $HOME; see docs/getting-started/deployment.md. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>fr.card-vault.deploy</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/Server/card-vault/docker/deploy/pull-deploy.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
        <key>CARD_VAULT_DIR</key>
        <string>__HOME__/Server/card-vault</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/card-vault-deploy.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/card-vault-deploy.log</string>
</dict>
</plist>
