# Front proxy (Caddy) - preproduction entry point (HTTP only)
# Routes /api/* to the FrankenPHP API, everything else to the Angular frontend. /ml/* answers 404: ML is internal only.
http://{$CADDY_DOMAIN_NAME} {
	encode zstd gzip

	handle /api {
		reverse_proxy api:8000
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle /bundles/* {
		reverse_proxy api:8000
	}

	handle /ml/* {
		respond 404
	}

	handle {
		reverse_proxy frontend:80
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
	}
}
